# App
APP_ENV=local
APP_NAME=elvira-respirarte-agent

# LangSmith
LANGSMITH_TRACING=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=elvira-respirarte-local

WHATSAPP_VERIFY_TOKEN=respirarte_elvira_2026

DATABASE_URL=postgresql://elvira_user:your_password_here@elvira_elvira:5432/elvira_respirarte_prod
# Knowledge Base runtime integration
KB_RUNTIME_ENABLED=false

# Voice safety limits
VOICE_MAX_MEDIA_BYTES=16777216

# Voice input
VOICE_INPUT_ENABLED=false
VOICE_REPLIES_ENABLED=false
VOICE_REPLY_TO_AUDIO_ONLY=true
VOICE_STT_MODEL=gpt-4o-transcribe
VOICE_STT_LANGUAGE=es

# Voice synthesis — disabled until P6-F.9.95 activation
VOICE_TTS_MODEL=gpt-4o-mini-tts
VOICE_TTS_VOICE=marin
VOICE_TTS_RESPONSE_FORMAT=opus

VOICE_PROCESSING_LEASE_SECONDS=300
VOICE_MAX_DURATION_SECONDS=120
VOICE_ALLOWED_PHONE_NUMBERS=

# P6-F.10 — Human escalation via WhatsApp
HUMAN_ESCALATION_ENABLED=false
HUMAN_ESCALATION_WHATSAPP_NUMBER=
HUMAN_ESCALATION_TEMPLATE_NAME=revision_humana
HUMAN_ESCALATION_TEMPLATE_LANGUAGE=es_CO
HUMAN_ESCALATION_DELIVERY_LEASE_SECONDS=120
